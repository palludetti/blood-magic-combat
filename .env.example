# ==============================================================================
# Supabase & PostgreSQL Configuration - Project: srasyydrtdwsywoktwjx
# ==============================================================================

# Supabase REST / Client URL and Anon Key (Public)
SUPABASE_URL=https://srasyydrtdwsywoktwjx.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# Supabase Project Ref (Para validação explícita de identidade do ambiente)
SUPABASE_PROJECT_REF=srasyydrtdwsywoktwjx

# Direct PostgreSQL Connection URL (para testes de catálogo e rollback atômico)
# Formato padrão: postgresql://postgres.[project-ref]:[DB_PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# NOTA: O host pode variar (pooler vs direto). Substitua com a connection string fornecida no Supabase Dashboard
TEST_DATABASE_URL=postgresql://postgres.srasyydrtdwsywoktwjx:YOUR_DB_PASSWORD_HERE@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Test Users (necessário para testes de RLS, autorização e isolamento cruzado)
# Os dois usuários de teste precisam existir no Supabase Auth e conseguir autenticar
TEST_USER_1_EMAIL=YOUR_TEST_USER_1_EMAIL_HERE
TEST_USER_1_PASSWORD=YOUR_TEST_USER_1_PASSWORD_HERE
TEST_USER_2_EMAIL=YOUR_TEST_USER_2_EMAIL_HERE
TEST_USER_2_PASSWORD=YOUR_TEST_USER_2_PASSWORD_HERE

# Usuário de demonstração para a CLI por terminal (pode reutilizar o TEST_USER_1)
DEMO_USER_EMAIL=YOUR_TEST_USER_1_EMAIL_HERE
DEMO_USER_PASSWORD=YOUR_TEST_USER_1_PASSWORD_HERE

# Flag explícita para habilitar o teste destrutivo de rollback controlado (desabilitado por padrão)
ENABLE_DESTRUCTIVE_ROLLBACK_TEST=false
